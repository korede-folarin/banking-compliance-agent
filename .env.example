# Copy this file to .env and fill in your real values. Never commit .env.

ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-5
CHROMA_PERSIST_DIR=./chroma_db
CONFIDENCE_THRESHOLD=0.65

# Optional. The values below are the defaults used when a line is left out.
# Audit logs (JSONL per run, plus index.jsonl); gitignored.
# LOG_DIR=./logs
# Human review decisions (append-only decisions.jsonl); gitignored because it holds reviewer names.
# REVIEW_DIR=./reviews
# End of the agent's 12-month account window.
# AGENT_REVIEW_DATE=2026-10-01
# Mock accounts served by the agent's MCP server.
# AGENT_ACCOUNTS_PATH=data/fixtures_v2/accounts.json
# Set to 1 to stop the embedding model contacting Hugging Face once it is cached.
# HF_HUB_OFFLINE=1
